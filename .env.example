# Oreon Build Service env
# copy to .env and fill in values

# Database
DATABASE_URL=postgresql+asyncpg://oreon:oreon@localhost:5432/oreon_build
# Optional: raise under heavy parallel workers (defaults 20 pool / 40 overflow / 60s wait)
# DATABASE_POOL_SIZE=20
# DATABASE_MAX_OVERFLOW=40
# DATABASE_POOL_TIMEOUT=60

# JWT / Session
SECRET_KEY=change-me-to-a-secure-random-string-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Default admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-secure-password

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=rpmrepo-us
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=

# Worker
WORKER_ENROLLMENT_SECRET=change-me-worker-secret
CONTROLLER_URL=http://localhost:8000
MOCK_CONFIG_DIR=/etc/mock

# Signing: controller GPG (rpm-sign) for RPM headers. Workers POST RPMs over HTTPS. Pesign NSS + rules
# live on the controller; workers download a per-attempt bundle (no R2 or NSS secrets on workers).
SIGNING_KEY_ID=
SIGNING_KEY_GRIP=
GPG_HOME=/var/lib/oreon-build/gnupg

# Optional: pesign PE binaries and *.ko (on workers before upload; controller still GPG-signs).
# Controller: NSS dir + rules or nickname (below). Workers: pesign, rpmrebuild, file, bash.
# Workers do not keep this. They stream a bundle from the API, unpack under /dev/shm when possible,
# sign, then rmtree the whole extract tree when that phase finishes (success, failure, or cancel path).
# PESIGN_NSS_DIR=/etc/pki/pesign
# Example if you generate NSS under oreon-secureboot-infra on the controller host
# PESIGN_NSS_DIR=/home/you/oreon-secureboot-infra/generated/nss-db
# PESIGN_TOKEN=
# PESIGN_STRICT=0
# Required for cross-arch aarch64 pesign repack on non-aarch64 hosts.
# -L must be a full AArch64 root with bin/sh (mock --root, podman export, etc.). Pure
# /usr/aarch64-linux-gnu on Fedora is not enough (no shell there).
# Optional explicit interpreter if -L is libc-only and your AArch64 sh lives elsewhere
# PESIGN_AARCH64_GUEST_SHELL=/var/lib/oreon/aarch64-root/bin/sh
# PESIGN_AARCH64_QEMU_PREFIX='qemu-aarch64-static -L /var/lib/oreon/aarch64-root'
# Or put the guest sh on the prefix line
# PESIGN_AARCH64_QEMU_PREFIX='qemu-aarch64-static -L /var/lib/oreon/aarch64-root /var/lib/oreon/aarch64-root/bin/sh'
#
# Multiple signers (first matching rule wins). Optional arch_regex limits rule to that RPM ARCH.
# Example (Oreon): grub -> oreon-grub2-signer; s390 kernel -> oreonsecureboot302; other kernel -> oreonsecureboot501.
# Use PESIGN_CERTIFICATE_NICKNAME + PESIGN_PACKAGE_NAME_REGEX for packages not covered by rules (e.g. shim, fwupd).
# PESIGN_RULES_JSON=[{"name_regex":"^grub2-efi.*","nickname":"oreon-grub2-signer"},{"name_regex":"^kernel.*","arch_regex":"^(s390x|s390)$","nickname":"oreonsecureboot302"},{"name_regex":"^kernel.*","nickname":"oreonsecureboot501"}]
# PESIGN_CERTIFICATE_NICKNAME=oreonsecureboot501
# PESIGN_PACKAGE_NAME_REGEX=^(kernel.*|shim.*|fwupd.*|grub2-efi.*)$

# Max size per RPM uploaded from worker to controller (MiB). Default is 51200 (50 GiB).
# If the worker gets HTTP 413, raise this and match any origin reverse-proxy limit (nginx
# client_max_body_size, etc.). With Cloudflare Tunnel, cloudflared usually is not the limiter;
# the process it forwards to (nginx or uvicorn) must accept large POST bodies.
# See deploy/nginx-oreon-build-api.conf.example
MAX_WORKER_RPM_UPLOAD_MIB=51200
# TTL (seconds) for presigned PUT URLs when workers upload large RPMs directly to R2.
# WORKER_RPM_PRESIGN_PUT_EXPIRES_SECONDS=7200

# Stuck builds (API background task): jobs stay "running" until a worker posts a result.
# If a worker dies, disk fills, or mock hangs, mark them failed automatically:
# BUILD_STALE_RUNNING_MINUTES=2880
# BUILD_STALE_WORKER_HEARTBEAT_MINUTES=120
# STALE_BUILD_SWEEP_INTERVAL_SECONDS=300

# GitHub (optional)
# GITHUB_API_URL defaults to https://api.github.com
# PAT for API (repo list, branch list, push catch-up compare). NOT the same as GITHUB_WEBHOOK_SECRET.
# GITHUB_TOKEN=
# Org login for repo listing (same as github.com/your-org)
# GITHUB_ORG=
# Webhook secret must match the value configured on the repo webhook (X-Hub-Signature-256)
# GITHUB_WEBHOOK_SECRET=
# Poll GitHub for commits since last webhook (needs GITHUB_TOKEN). Seconds between runs, 0 disables.
# GITHUB_CATCHUP_INTERVAL_SECONDS=600
# First run catch-up window size (recent commits to replay when no cursor exists).
# 0 is safest default to avoid surprise mass rebuilds.
# GITHUB_CATCHUP_BOOTSTRAP_COMMITS=0
# Hard cap of jobs catch-up can enqueue in one cycle (prevents flood/spam).
# GITHUB_CATCHUP_MAX_JOBS_PER_CYCLE=10

# Integrations
# Discord webhook to receive audit and build events. (optional)
DISCORD_WEBHOOK_URL=
# Discord webhook dedicated to security advisories. (optional)
SECURITY_DISCORD_WEBHOOK_URL=

# Oreon Watchdog (security advisory dashboard)
WATCHDOG_URL=http://localhost:8001
WATCHDOG_CVE_SCAN_INTERVAL_MINUTES=30

# Logging
LOG_LEVEL=INFO
