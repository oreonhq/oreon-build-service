#
# Drop into server { } / location that reverse-proxies the oreon API (uvicorn).
# Default nginx client_max_body_size is 1m and causes HTTP 413 on large SRPM uploads.
# Oreon default MAX_WORKER_RPM_UPLOAD_MIB is 51200 MiB (50 GiB). Slight headroom for multipart.

client_max_body_size 60G;
proxy_connect_timeout 300s;
proxy_send_timeout 7200s;
proxy_read_timeout 7200s;
