# Worker needs only the controller URL, this token (from UI enrollment), and tuning vars.
# Logs, SRPM blobs, and pesign NSS material are fetched from the controller over HTTPS (no R2 keys).

CONTROLLER_URL=http://controller:8000
OREON_WORKER_TOKEN=
OREON_WORKER_NAME=worker-1

# Concurrent build threads on this host (default 4, capped ~8). Each job uses mock --uniqueext
# for separate chroots under /var/lib/mock, and by default mock --config-opts cache_topdir=... per
# attempt so dnf5 does not share /var/cache/mock/<root>/dnf_cache (parallel tmpdir races).
# To use one shared host dnf cache again (less disk, unsafe with parallel jobs): OREON_WORKER_MOCK_SHARED_CACHE=1
# Optional parent for per-attempt dirs (default /var/cache/mock -> .../oreon-<attempt_id>/):
# OREON_WORKER_MOCK_CACHE_PARENT=/var/cache/mock
# OREON_WORKER_MAX_JOBS=4

# Scratch + cleanup (recommended on busy workers so /tmp and /var/lib/mock do not fill up)
# Put worker job temp dirs under a dedicated path (created if missing):
# OREON_WORKER_TMP_PARENT=/var/tmp/oreon-build-worker
# Delete stale oreon-worker-* dirs under TMPDIR / OREON_WORKER_TMP_PARENT after N seconds (0 = off):
# OREON_WORKER_PRUNE_TMP_AGE_SEC=300
# mock --scrub=all timeout per job (seconds):
# OREON_WORKER_MOCK_SCRUB_TIMEOUT_SEC=3600
# How long to wait for POST /api/worker/result/... (createrepo + R2 on the controller). Default 900s.
# OREON_WORKER_RESULT_POST_TIMEOUT_SEC=900
# mock --buildsrpm / mock --rebuild wall-clock caps (seconds). Default is 5 days; max env value 30 days.
# OREON_WORKER_MOCK_BUILDSRPM_TIMEOUT_SEC=432000
# OREON_WORKER_MOCK_REBUILD_TIMEOUT_SEC=432000
#
# After long mock, controller TCP connections can go stale (proxies, idle timeouts). Retries help
# log upload, pesign bundle download, and RPM upload. Default 5 attempts, 2s base backoff (capped).
# OREON_WORKER_HTTP_RETRIES=5
# OREON_WORKER_HTTP_RETRY_BASE_SEC=2
#
# RPM upload: default is presigned PUT straight to R2 + small API complete (avoids tunnel POST limits).
# Workers need HTTPS egress to your R2 endpoint. Set to 0 to use legacy multipart POST to the controller
# (413 on that path still falls back to presigned R2 once).
# OREON_WORKER_RPM_UPLOAD_VIA_PRESIGNED_R2=0
# POST /upload-rpm/complete can take a long time when the controller is busy (R2 read + hash + GPG).
# Default read timeout 32400s (9h). Extra retries (default 5) for specific HTTP 400 cases (R2 lag / verify race).
# OREON_WORKER_RPM_COMPLETE_TIMEOUT_SEC=32400
# OREON_WORKER_RPM_COMPLETE_EXTRA_RETRIES=5
#
# Build logs: same idea as RPMs (default presigned PUT to R2 + small complete). Stops huge mock logs
# from timing out on Cloudflare (HTTP 524) while the API buffers and forwards to R2.
# OREON_WORKER_BUILD_LOG_VIA_PRESIGNED_R2=0
# Legacy PUT /build-log read timeout when presign is off (seconds, default 7200):
# OREON_WORKER_BUILD_LOG_PUT_TIMEOUT_SEC=7200

# mock often leaves *.rpm / build.log under root-owned dirs. The worker always runs chmod -R a+rX
# on each mock --resultdir right after mock returns (before reading logs). If that is not enough:
# OREON_WORKER_CHMOD_MOCK_RESULTDIR_SUDO=1
# Runs sudo -n chmod -R a+rX <resultdir>. Add sudoers (tighten paths to your TMP_PARENT):
#   oreon-build ALL=(root) NOPASSWD: /usr/bin/chmod -R a+rX /tmp/oreon-worker-*
#   oreon-build ALL=(root) NOPASSWD: /usr/bin/chmod -R a+rX /var/tmp/oreon-build-worker/oreon-worker-*
# OREON_WORKER_SKIP_CHMOD_MOCK_RESULTDIR=1
# Rare: skip the non-sudo chmod only.

# RPM dist macro in Release / filenames: default is .or<N> where N is the first digit run in the job releasename
# (e.g. oreon-11-rp1 -> .or11) via mock --define dist ... so you get ...or11.rpm instead of ...fc45.rpm.
# OREON_WORKER_RPM_DIST=or9          # force dist tag (with or without leading dot)
# OREON_WORKER_SKIP_RPM_DIST_OVERRIDE=1   # keep mock chroot default (fcXX) instead
#
# Optional comma-separated extra mock --addrepo base URLs on top of URLs configured on the mock environment in the web UI.
# OREON_WORKER_EXTRA_MOCK_ADDREPO=https://example.com/my-repo

# PEM payload signing (optional): install pesign rpmrebuild file bash findutils on workers that build
# kernel/shim/etc. The controller streams a bundle per job. The worker never writes the tarball to
# disk, keeps extracted NSS only under /dev/shm (tmpfs) when available, and deletes it after signing.
# OREON_WORKER_PESIGN_EXTRACT_DIR=/run/user/1000/oreon-pesign   # optional override parent dir (ramfs)
# OREON_WORKER_PESIGN_BUNDLE_MAX_MIB=256
