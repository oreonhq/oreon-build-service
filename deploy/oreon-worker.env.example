CONTROLLER_URL=http://controller:8000
OREON_WORKER_TOKEN=
OREON_WORKER_NAME=worker-1

# Concurrent build threads on this host (default 4, capped ~8). Each job uses mock --uniqueext
# so chroots do not collide; very high values can still contend on mock’s shared caches.
# OREON_WORKER_MAX_JOBS=4

# Scratch + cleanup (recommended on busy workers so /tmp and /var/lib/mock do not fill up)
# Put worker job temp dirs under a dedicated path (created if missing):
# OREON_WORKER_TMP_PARENT=/var/tmp/oreon-build-worker
# Delete stale oreon-worker-* dirs under TMPDIR / OREON_WORKER_TMP_PARENT after N seconds (0 = off):
# OREON_WORKER_PRUNE_TMP_AGE_SEC=300
# mock --scrub=all timeout per job (seconds):
# OREON_WORKER_MOCK_SCRUB_TIMEOUT_SEC=3600
# How long to wait for POST /api/worker/result/... (createrepo + R2 on the controller). Default 900s.
# OREON_WORKER_RESULT_POST_TIMEOUT_SEC=900
# mock --buildsrpm / mock --rebuild wall-clock caps (seconds). Default is 5 days; max env value 30 days.
# OREON_WORKER_MOCK_BUILDSRPM_TIMEOUT_SEC=432000
# OREON_WORKER_MOCK_REBUILD_TIMEOUT_SEC=432000

# mock often leaves *.rpm / build.log under root-owned dirs. The worker always runs chmod -R a+rX
# on each mock --resultdir right after mock returns (before reading logs). If that is not enough:
# OREON_WORKER_CHMOD_MOCK_RESULTDIR_SUDO=1
# Runs sudo -n chmod -R a+rX <resultdir>. Add sudoers (tighten paths to your TMP_PARENT):
#   oreon-build ALL=(root) NOPASSWD: /usr/bin/chmod -R a+rX /tmp/oreon-worker-*
#   oreon-build ALL=(root) NOPASSWD: /usr/bin/chmod -R a+rX /var/tmp/oreon-build-worker/oreon-worker-*
# OREON_WORKER_SKIP_CHMOD_MOCK_RESULTDIR=1
# Rare: skip the non-sudo chmod only.

# R2 used for build logs only (same bucket/creds as controller). RPMs are sent to the
# controller over HTTPS; the controller signs them and writes to R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=oreon-repos
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
